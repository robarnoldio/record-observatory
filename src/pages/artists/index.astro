---
import fs from 'node:fs';
import path from 'node:path';

const referenceDir = path.resolve('reference');

const artists = fs
  .readdirSync(referenceDir)
  .filter(name => name.endsWith('.json'))
  .map(name => {
    const slug = name.replace(/\.json$/, '');

    const displayName = slug
      .split('-')
      .map(word => word.charAt(0).toUpperCase() + word.slice(1))
      .join(' ');

    return {
      slug,
      displayName
    };
  })
  .sort((a, b) => a.displayName.localeCompare(b.displayName));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Artist Collections</title>
  </head>

  <body>
     <pre>       ╔═════════════╗
       ║ <a href="/">OBSERVATORY</a> ║[<a href="/artists/">ARTISTS</a>]</pre>

<div class="artist-wrapper">
<pre>╔════════════════════════
 {artists.map(artist => (
╠  <a href={`/artists/${artist.slug}/`}>{artist.displayName}</a> <br />
  ))}
</pre>
</div>

<style>
  .artist-wrapper {
    margin-left: 4rem;
    margin-right: 4rem;
  }
</style>
  </body>
</html>