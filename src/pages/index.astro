---
import { loadLpCollection } from '../lib/collection.js';

const {
  csvFilename,
  collection,
  lpCollection,
  exportDateString
} = loadLpCollection();
import CollectionDump from '../components/collectiondump.astro';
import MonthlyAcquisitions from '../components/monthlyacquisitions.astro';
import SourceSummary from '../components/sourcesummary.astro';
import YearSummary from '../components/releaseyearsummary.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Record collection observatory</title>
	</head>
	<body>
		<h1>Some bozo collecting records</h1>
		<p>Rob is the proud owner of {lpCollection.length} rekkids.</p>
		<p>The latest collection dump available is from {exportDateString}.</p>

		<MonthlyAcquisitions collection={lpCollection} />

		<SourceSummary collection={lpCollection} />

		<YearSummary collection={lpCollection} />
	</body>
</html>
