---
import fs from 'node:fs';
import path from 'node:path';
import { parse } from 'csv-parse/sync';

import artistReference from '../../reference/herbie-hancock.json';

// Find the most recent Discogs collection export.
const collectionDir = path.resolve('data/collection');

const csvFiles = fs
  .readdirSync(collectionDir)
  .filter(name => /^Robarnold-collection-.*\.csv$/.test(name))
  .sort();

if (csvFiles.length === 0) {
  throw new Error('No Discogs collection CSV found');
}

const csvFilename = csvFiles.at(-1);
const csvPath = path.join(collectionDir, csvFilename);

const csvText = fs.readFileSync(csvPath, 'utf8');

const collection = parse(csvText, {
  columns: true,
  skip_empty_lines: true,
});

// For this first pass, just find collection records whose
// Artist field contains "herbie hancock".
const artistCollection = collection.filter(record =>
  record.Artist?.toLowerCase().includes('herbie hancock') &&
  record.Format?.split(',').some(x => /^\d*xLP$|^LP$/.test(x.trim()))
);

const vsopDebug = collection.filter(record =>
  record.Title?.toLowerCase().includes('evening with')
);

//console.log(vsopDebug);

function normalizeTitle(title) {
  return title
    .toLowerCase()
    .trim();
}

const reconciliation = artistReference.map(reference => {
  const matches = artistCollection.filter(record =>
    normalizeTitle(record.Title) === normalizeTitle(reference.title)
  );

  return {
    ...reference,
    owned: matches.length > 0,
    copies: matches
  };
});

const ownedCount = reconciliation.filter(record => record.owned).length;
const missingCount = reconciliation.length - ownedCount;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Herbie Reconciliation Test</title>
  </head>

  <body>
    <h1>Herbie Reconciliation Test</h1>

    <p>Discogs export: {csvFilename}</p>

    <h2>Input counts</h2>

    <ul>
      <li>Reference records: {artistReference.length}</li>
      <li>Total collection records: {collection.length}</li>
      <li>Collection records containing "Herbie Hancock": {artistCollection.length}</li>
    </ul>

<h2>Reconciliation</h2>

<p>
  Owned: {ownedCount} / {reconciliation.length}<br />
  Missing: {missingCount}
</p>

<table>
  <thead>
    <tr>
      <th>Year</th>
      <th>Title</th>
      <th>Status</th>
      <th>Copies</th>
    </tr>
  </thead>

  <tbody>
    {reconciliation.map(record => (
      <tr>
        <td>{record.year}</td>
        <td>{record.title}</td>
        <td>{record.owned ? 'OWNED' : 'MISSING'}</td>
        <td>{record.copies.length}</td>
      </tr>
    ))}
  </tbody>
</table>
  </body>
</html>
