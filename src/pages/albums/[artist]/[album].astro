---
import { displayArtist, loadAlbumPages } from '../../../lib/albums.js';
import { copyFlags, formatIndicators, isMono, valueOrUnknown } from '../../../lib/formats.js';
import AlbumTextLayout from '../../../components/albumtextlayout.astro';
import { headingLine } from '../../../lib/text.js';
import AlbumTextDivider from '../../../components/albumtextdivider.astro';

export function getStaticPaths() {
  const { albums, exportDateString } = loadAlbumPages();
  // The record bin is the index order: each album knows the one before and after it.
  const neighbor = other => other && { href: other.href, title: other.title };
  return albums.map((album, index) => ({
    params: { artist: album.artistSlug, album: album.albumSlug },
    props: { album, exportDateString, prev: neighbor(albums[index - 1]), next: neighbor(albums[index + 1]) },
  }));
}

const { album, exportDateString, prev, next } = Astro.props;
const indexHref = `/albums/#artist-${album.artistSlug}`;
const siblingTitles = loadAlbumPages().albums
  .filter(other => other.artistKey === album.artistKey && other !== album)
  .map(other => other.title);
const heading = headingLine(album.artist, album.title, siblingTitles);
---
<AlbumTextLayout title={`${album.artist} — ${album.title}`} dashboardTypography navTabbable={false}>
      <p class="album-heading">{heading.shortened
        ? <><span aria-hidden="true">{heading.text}</span><span class="visually-hidden">{heading.full}</span></>
        : heading.text}</p>
      {album.copies.map((copy, index) => (
        <section aria-labelledby={`copy-${index + 1}`}>
          <AlbumTextDivider id={`copy-${index + 1}`} title={`owned copy ${index + 1}`} stats={`${index + 1} of ${album.copies.length}`} flags={copyFlags(copy)} />
          <dl>
            <dt>Artist credit</dt><dd>{displayArtist(copy.Artist)}</dd>
            <dt>Title</dt><dd>{copy.Title}</dd>
            <dt>Released</dt><dd>{copy.Released || 'Unknown'}</dd>
            <dt>Label</dt><dd>{copy.Label || 'Unknown'}</dd>
            {copy['Catalog#'] && <><dt>Catalog number</dt><dd>{copy['Catalog#']}</dd></>}
            <dt>Format</dt><dd><ul class="format-indicators">{(formatIndicators(copy.Format).length ? formatIndicators(copy.Format) : ['unknown']).map(indicator => <li>{indicator}</li>)}</ul></dd>
            <dt>Media condition</dt><dd>{valueOrUnknown(copy['Collection Media Condition'])}</dd>
            <dt>Sleeve condition</dt><dd>{valueOrUnknown(copy['Collection Sleeve Condition'])}</dd>
            {copy['Collection Source']?.trim() && <><dt>Source</dt><dd>{copy['Collection Source'].trim()}</dd></>}
            <dt>Location</dt><dd>{valueOrUnknown(copy.CollectionFolder)}</dd>
          </dl>
          {isMono(copy.Format) && <p class="mono-note">++ in glorious mono ++</p>}
          {copy['Collection Notes'] && <p class="notes">{copy['Collection Notes']}</p>}
          {/^[1-9]\d*$/.test(copy.release_id ?? '') && (
            <p><a href={`https://www.discogs.com/release/${copy.release_id}`} target="_blank" rel="noopener noreferrer" tabindex="0">View this release on Discogs ↗<span class="visually-hidden"> (opens in a new tab)</span></a></p>
          )}
        </section>
      ))}
      <nav class="record-bin" aria-label="Flip through the record bin">{prev
        ? <a href={prev.href} title={prev.title} aria-label={`Previous album: ${prev.title}`} tabindex="0">‹ prev</a>
        : <span class="dim">‹ prev</span>}{'   '}<a href={indexHref} tabindex="0">return to index</a>{'   '}{next
        ? <a href={next.href} title={next.title} aria-label={`Next album: ${next.title}`} tabindex="0">next ›</a>
        : <span class="dim">next ›</span>}</nav>
      <footer>Collection export: {exportDateString}</footer>
</AlbumTextLayout>
<style>
  .record-bin { white-space: pre; margin: 1.25rem 0 0; }
  .record-bin .dim { color: GrayText; }
</style>
