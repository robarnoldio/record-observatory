---
import { artistInitial, loadAlbumPages } from '../../lib/albums.js';
import AlbumTextLayout from '../../components/albumtextlayout.astro';
import AlbumTextDivider from '../../components/albumtextdivider.astro';
import { SLOT, headingLine, leaderGap, shorten, shortenUnique } from '../../lib/text.js';
import { albumMeta } from '../../lib/formats.js';
import { groupByYear, yearCounts } from '../../lib/years.js';
import AlphabetPicker from '../../components/alphabetpicker.astro';
import YearPicker from '../../components/yearpicker.astro';
const { albums } = loadAlbumPages();
const artists = new Map();
for (const album of albums) {
  if (!artists.has(album.artistKey)) artists.set(album.artistKey, []);
  artists.get(album.artistKey).push(album);
}
// A row is a 2-column indent, a 7-column year, a 1-column gap, then the title.
const ROW_TITLE_MAX = SLOT - 7 - 1;
const yearGroups = groupByYear(albums);
const { counts, unknown } = yearCounts(yearGroups);
// Siblings (same artist) keep year-view rows distinguishable, like the album-page heading.
const titlesByArtist = new Map([...artists.entries()].map(([key, entries]) => [key, entries.map(album => album.title)]));
const initials = [...artists.values()].map(entries => artistInitial(entries[0].artist));
---
<AlbumTextLayout title="Owned LP albums" dashboardTypography>
  <h1 class="visually-hidden">Owned LP albums</h1>
  <div class="pickers">
    <AlphabetPicker available={initials} />
    <YearPicker counts={counts} unknown={unknown} />
  </div>
  <div data-bin="artist">
  {Array.from(artists.values(), (entries, index) => (
    <section id={`artist-${entries[0].artistSlug}`} data-letter={initials[index]}>
      <AlbumTextDivider
        title={shortenUnique(entries[0].artist, [], 70)}
        fullTitle={entries[0].artist}
        stats={`${entries.length} ${entries.length === 1 ? 'album' : 'albums'} · ${entries.reduce((total, album) => total + album.copies.length, 0)} owned copies`}
      >
        <ul class="album-links">{entries.map(album => (
          <li>
            <span>{album.year ?? 'unknown'}</span>
            <span><a href={album.href} aria-label={album.title} tabindex="0">{shortenUnique(album.title, entries.map(other => other.title), ROW_TITLE_MAX - (album.copies.length > 1 ? ` [${album.copies.length}]`.length : 0))}</a>{album.copies.length > 1 && ` [${album.copies.length}]`}</span>
          </li>
        ))}</ul>
      </AlbumTextDivider>
    </section>
  ))}
  </div>
  <div data-bin="year" hidden>
  {yearGroups.map(group => (
    <section data-year-section={group.key} data-decade={group.decade ?? 'unknown'}>
      <AlbumTextDivider
        title={group.year === null ? 'unknown year' : String(group.year)}
        stats={`${group.albums.length} ${group.albums.length === 1 ? 'album' : 'albums'}`}
      >
        <ul class="album-links year-rows">{group.albums.map(album => {
          const suffix = album.copies.length > 1 ? ` [${album.copies.length}]` : '';
          // Line 1: artist on the left, title (the only link) on the right, a dot leader between.
          // The separator budget in headingLine (4) is exactly the minimum gap. Line 2: year and label.
          const line = headingLine(album.artist, album.title, titlesByArtist.get(album.artistKey), SLOT - suffix.length);
          const gap = leaderGap(line.artistText.length + line.titleText.length + suffix.length);
          const meta = albumMeta(album);
          return <li>
            <span class="line">{line.artistText}{gap}<a href={album.href} aria-label={line.full} tabindex="0">{line.titleText}</a>{suffix}</span>
            {meta && <span class="line meta">{'   '}{shorten(meta, SLOT - 3)}</span>}
          </li>;
        })}</ul>
      </AlbumTextDivider>
    </section>
  ))}
  </div>
</AlbumTextLayout>
<style>
  /* The two pickers sit side by side; the year picker starts at column 40 of the 78. */
  .pickers { display: flex; margin-top: calc(1lh + 1rem); margin-bottom: calc(1lh + 0.75rem); }
</style>
