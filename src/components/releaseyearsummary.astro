---
import { sortByCount, sortByNumKey } from '../lib/collection.js'; 
import {frameHeader,frameFooter,fillTo} from '../lib/frame.js';

const { collection } = Astro.props;

const yearCounts = collection.reduce((counts, record) => {
  const yearReleased = record['Released'];

  if (!yearReleased || Number(yearReleased) === 0) {
    return counts;
  }

  counts[yearReleased] =
    (counts[yearReleased] || 0) + 1;

  return counts;
}, {});


const years = sortByNumKey(
  Object.entries(yearCounts)
);
const yearsByCount = sortByCount(
  Object.entries(yearCounts)
);

const yearRows = years.map(([year, count]) =>
  `${year.padEnd(6)} ${'█'.repeat(count)} ${count}`
);

const countRows = yearsByCount.map(([year, count]) =>
  `${year.padEnd(6)} ${'█'.repeat(count)} ${count}`
);

const footer = frameFooter();

---
<div class="year-breakdown-header">
  ╔══ {collection.length} releases by ══
  <button data-sort="YEAR">[YEAR]</button>
  ═
  <button data-sort="COUNT"> COUNT </button>
  ════════════════════════════════════════╗
</div>

<div class="year-view" data-mode="YEAR">
  <pre>
{
  years.map(([year, count]) =>
    `   ${year.padEnd(6)} ${'█'.repeat(count)} ${count}`
  ).join('\n')
}
  </pre>
</div>

<div class="year-view" data-mode="COUNT">
  <pre>
{
  yearsByCount.map(([year, count]) =>
    `   ${year.padEnd(6)} ${'█'.repeat(count)} ${count}`
  ).join('\n')
}
  </pre>
</div>

<pre>{footer}</pre>
<style>
  .year-breakdown-header {
  font-family: monospace;
  white-space: pre;
}

.year-breakdown-header button {
  font: inherit;
  background: none;
  border: 0;
  padding: 0;
  margin: 0;
  color: inherit;
  cursor: pointer;
}
</style>

<script>
  let currentSort = 'YEAR';

const buttons =
  document.querySelectorAll('[data-sort]');

const views =
  document.querySelectorAll('.year-view');

function applySort(sort) {
  currentSort = sort;

  buttons.forEach(button => {
    const label = button.dataset.sort;

    button.textContent =
      label === currentSort
        ? `[${label}]`
        : ` ${label} `;
  });

  views.forEach(view => {
    view.style.display =
      view.dataset.mode === currentSort
        ? ''
        : 'none';
  });
}

buttons.forEach(button => {
  button.addEventListener('click', () => {
    applySort(button.dataset.sort);
  });
});

applySort(currentSort);
</script>