---
import { loadAlbumPages } from '../lib/albums.js';
import AlbumStatsField from './albumstatsfield.astro';
import Shell from '../layouts/Shell.astro';
const { title, dashboardTypography = false, navTabbable = true } = Astro.props;
const { albums, artistCount, copyCount, exportDateString } = loadAlbumPages();
const exportDate = new Date(exportDateString);
const asOf = Number.isNaN(exportDate.getTime()) ? exportDateString
  : exportDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const statLines = [
  `Stats :: ${artistCount} artists`,
  `${albums.length} albums :: ${copyCount} LP copies`,
  `as of ${asOf}`,
];
---
<Shell title={`${title} | Record Observatory`} navTabbable={navTabbable}>
    <main class:list={{ 'dashboard-typography': dashboardTypography }}>
      <AlbumStatsField lines={statLines} />
      <slot />
    </main>
</Shell>
<style>
  body { font-family: monospace; font-size: 1rem; line-height: 1.15; margin: 8px; }
  main { max-width: 90ch; margin-left: 4rem; }
  .dashboard-typography { font-size: 1rem; line-height: normal; }
  main :global(h1) { font: inherit; margin: 0.5rem 0; }
  main :global(.visually-hidden) { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  main :global(section) { margin-bottom: 0.5rem; }
  main :global(p) { margin: 0.5em 0; }
  main :global(dl) { display: grid; grid-template-columns: 18ch minmax(0, 1fr); gap: 0.25rem 2ch; }
  main :global(dt) { font-weight: normal; }
  main :global(dd) { margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; }
  main :global(.notes) { white-space: pre-wrap; overflow-wrap: anywhere; }
  main :global(.album-links) { padding-left: 2ch; margin: 0; list-style: none; }
  main :global(.album-links li) { display: grid; grid-template-columns: 7ch minmax(0, 1fr); gap: 1ch; margin-bottom: 0; overflow-wrap: anywhere; }
  main :global(.year-rows li) { display: block; margin-bottom: 0.15em; }
  main :global(.year-rows .line) { display: block; white-space: pre; }
  main :global(.album-heading) { font: inherit; white-space: pre; overflow-x: auto; overflow-y: hidden; padding: 0.15em 2ch; margin: 1em 0; }
  main :global(.format-indicators) { list-style: none; padding: 0; margin: 0; }
  main :global(footer) { margin-top: 1rem; }
  @media (max-width: 48rem) {
    main { margin-left: 0; }
    main :global(dl) { grid-template-columns: 15ch minmax(0, 1fr); gap: 0.25rem 1ch; }
  }
</style>
