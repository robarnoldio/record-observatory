---
const { catalog, views = [], defaultView = 'catalog' } = Astro.props;
import AlbumCard from './AlbumCard.astro';
import { fillTo } from '../lib/frame';
---
<style>
:global(
  .album-grid-container[data-view="catalog"]
  .album-wrapper[data-owned="false"]
  .cover-container
) {
  opacity: 0.45;
}
  .view-filter {
    font-family: monospace;
    white-space: pre;
    margin-bottom: 1rem;
    cursor: pointer;
  }

  .view-filter button {
    font-family: inherit;
    border: 0;
    background: none;
    cursor: pointer;
    padding: 0;
    margin: 0;
  }

  .album-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, 150px);
    gap: 0.2rem;
    margin-top: 0.2rem;
  }

  .album-grid-container {
    width: 80%;
    margin: 0 auto;
  }

  .album-section-stats {
    font-weight: normal;
  }
</style>

<div class="album-grid-container">

  <div class="view-filter">
    ::
    <button data-view="catalog">[CATALOG]</button>
    ::
    <button data-view="owned">OWNED</button>
    ::
    <button data-view="wanted">WANTED</button>
    ::
  </div>

  {
    Object.entries(
      catalog.reduce((groups, album) => {
        const section = album.section || 'Miscellaneous';
        if (!groups[section]) {
          groups[section] = [];
        }
        groups[section].push(album);
        return groups;
      }, {})
    )
      .filter(([section]) => !section.startsWith('_'))
      .map(([section, albums]) => {
        const owned = albums.filter(
          album => album.copies?.length > 0
        ).length;

        const total = albums.length;
        const needed = total - owned;

        const percent = total
          ? Math.round((owned / total) * 100)
          : 0;

        const headerTop = fillTo(
          `╔═══ ${section.toLowerCase()} `,
          '╗',
          78,
          '═'
        );

        const headerCatalog = fillTo(
          '╚',
          ` ${owned} of ${total} [${percent}%] ══╝`,
          78,
          '═'
        );

        const headerWanted = fillTo(
          '╚',
          ` ${needed} needed ══╝`,
          78,
          '═'
        );

        return (
<div
  class="album-section"
  data-section={section}
>

  <pre class="section-divider">
{headerTop}
<span
  class="catalog-stats"
  data-owned={owned}
  data-total={total}
  data-needed={needed}
>{headerCatalog}</span><span
  class="wanted-stats"
  data-needed={needed}
  style="display:none;"
>{headerWanted}</span>
  </pre>

            <div class="album-grid">
              {albums.map(album => (
                <div
                  class="album-wrapper"
                  data-owned={album.copies?.length > 0 ? 'true' : 'false'}
                  data-section={section}
                >
                  <AlbumCard album={album} />
                </div>
              ))}
            </div>
          </div>
        );
      })
  }

</div>


<script>
  let currentView = 'catalog';

  const buttons = document.querySelectorAll('[data-view]');
  const cards = document.querySelectorAll('.album-wrapper');

  function applyView(view) {
    currentView = view;

    const sections = document.querySelectorAll('.album-section');

    sections.forEach(section => {
      const sectionName = section.dataset.section;
      const header = section.querySelector('.section-divider');

      if (view === 'wanted') {
        header.style.display =
          sectionName === 'Albums'
            ? ''
            : 'none';
      } else {
        header.style.display = '';
      }
    });

    document
      .querySelectorAll('.catalog-stats')
      .forEach(el => {
        el.style.display =
          view === 'wanted'
            ? 'none'
            : '';
      });

    document
      .querySelectorAll('.wanted-stats')
      .forEach(el => {
        el.style.display =
          view === 'wanted'
            ? ''
            : 'none';
      });
    
    document
      .querySelector('.album-grid-container')
      .dataset.view = view;
      
    buttons.forEach(button => {
      const label = button.dataset.view.toUpperCase();
      button.textContent =
        button.dataset.view === currentView
          ? `[${label}]`
          : ` ${label} `;
    });

    cards.forEach(card => {
      const owned = card.dataset.owned === 'true';
      const section = card.dataset.section;

      let visible = true;

      if (view === 'owned') {
        visible = owned;
      }

      if (view === 'wanted') {
        visible = !owned && section === 'Albums';
      }

      card.style.display = visible ? '' : 'none';
    });

    sections.forEach(section => {
      const sectionName = section.dataset.section;

      const visibleCards = Array.from(
        section.querySelectorAll('.album-wrapper')
      ).filter(card => card.style.display !== 'none');

      if (
        currentView === 'wanted' &&
        sectionName === 'Albums'
      ) {
        section.style.display = '';
        return;
      }

      section.style.display =
        visibleCards.length > 0
          ? ''
          : 'none';
    });
  }

  buttons.forEach(button => {
    button.addEventListener('click', () => {
      applyView(button.dataset.view);
    });
  });

  applyView(currentView);
</script>
