---
// `tabbable={false}` takes the tabs out of the keyboard tab order (they stay clickable). An
// explicit tabindex="0" otherwise, because some browsers (Safari, Vivaldi) skip plain links on Tab.
const { tabbable = true } = Astro.props;
const pathname = Astro.url.pathname;
const active = /^\/artists(?:\/|$)/.test(pathname) ? '/artists/'
  : /^\/albums(?:\/|$)/.test(pathname) ? '/albums/' : '/';
const tabs = [['/', 'OBSERVATORY'], ['/artists/', 'ARTISTS'], ['/albums/', 'LP ALBUMS']];
// The selected tab is bracketed; the others are padded with spaces. Both are part of the link.
const edges = href => (href === active ? ['[', ']'] : [' ', ' ']);
const current = href => href === active
  ? (pathname.replace(/\/$/, '') === href.replace(/\/$/, '') ? 'page' : 'location')
  : undefined;
---
<nav aria-label="Main navigation"><pre>       ╔═════════════╗         ╔═══════════╗
       ║{tabs.map(([href, text]) => <Fragment><a href={href} aria-current={current(href)} tabindex={tabbable ? 0 : -1}><span>{edges(href)[0]}</span><span>{text}</span><span>{edges(href)[1]}</span></a>║</Fragment>)}
                     ╚═════════╝</pre></nav>
<style>
  pre { font-family: monospace; font-size: 1rem; line-height: normal; white-space: pre; overflow-x: auto; overflow-y: hidden; padding-block: 0.15em; }
</style>
