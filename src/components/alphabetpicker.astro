---
// QWERTY-shaped letter picker. The selected letter is bracketed, none is selected by default,
// and letters with no matching artists are disabled. The `*` key selects the '#' bucket: artists
// that don't start with A-Z, like "Weird Al" Yankovic. Filtering hides every [data-letter] element
// whose letter differs from the selection.
// The keys are a single tab stop (roving tabindex): Tab enters and leaves the group, the arrow
// keys move between keys, and Space or Enter selects.
const { available = [] } = Astro.props;
const ROWS = ['QWERTYUIOP', 'ASDFGHJKL', 'ZXCVBNM#'];
const labelFor = key => (key === '#' ? '*' : key);
const firstKey = [...ROWS.join('')].find(key => available.includes(key)); // the initial tab stop
const COLUMN_STAGGER = 1; // each row shifts right by one column, like a real keyboard
const INDENT = 8;
---
<div role="toolbar" aria-label="Filter artists by letter" class="alphabet-picker" data-alphabet-picker>
  <pre>{ROWS.map((letters, row) => <Fragment>{' '.repeat(INDENT + COLUMN_STAGGER * row)}{[...letters].map((letter, col) => <button type="button" tabindex={letter === firstKey ? 0 : -1} data-row={row} data-col={col} data-letter-button={letter} data-label={labelFor(letter)} aria-pressed="false" aria-label={letter === '#' ? 'Other (not A to Z)' : undefined} disabled={!available.includes(letter)}>{` ${labelFor(letter)} `}</button>)}{'\n'}</Fragment>)}</pre>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-alphabet-picker]').forEach(picker => {
    const buttons = picker.querySelectorAll<HTMLButtonElement>('button[data-letter-button]');
    let selected: string | null = null;
    function apply() {
      buttons.forEach(button => {
        const letter = button.dataset.letterButton!;
        const on = letter === selected;
        const label = button.dataset.label!;
        button.textContent = on ? `[${label}]` : ` ${label} `;
        button.setAttribute('aria-pressed', String(on));
      });
      document.querySelectorAll<HTMLElement>('[data-letter]').forEach(section => {
        section.hidden = selected !== null && section.dataset.letter !== selected;
      });
    }
    // Roving tabindex: exactly one key is in the tab order, the one last focused.
    let current = [...buttons].find(b => b.tabIndex === 0) ?? buttons[0];
    function setCurrent(button: HTMLButtonElement) {
      current.tabIndex = -1;
      current = button;
      current.tabIndex = 0;
    }
    const at = (row: number, col: number) => {
      const inRow = [...buttons].filter(b => Number(b.dataset.row) === row && !b.disabled);
      return inRow.find(b => Number(b.dataset.col) === col) ?? inRow.filter(b => Number(b.dataset.col) < col).at(-1) ?? inRow[0];
    };
    picker.addEventListener('keydown', event => {
      const key = (event as KeyboardEvent).key;
      const row = Number(current.dataset.row), col = Number(current.dataset.col);
      const rowKeys = [...buttons].filter(b => Number(b.dataset.row) === row && !b.disabled);
      let next: HTMLButtonElement | undefined;
      if (key === 'ArrowRight') next = rowKeys.find(b => Number(b.dataset.col) > col);
      else if (key === 'ArrowLeft') next = rowKeys.filter(b => Number(b.dataset.col) < col).at(-1);
      else if (key === 'ArrowDown') next = at(row + 1, col);
      else if (key === 'ArrowUp') next = at(row - 1, col);
      else if (key === 'Home') next = rowKeys[0];
      else if (key === 'End') next = rowKeys.at(-1);
      else return;
      event.preventDefault();
      if (next) next.focus();
    });
    // Choosing a decade or year clears the letter selection (the list switches to year groups).
    window.addEventListener('bin-change', event => {
      const { source, active } = (event as CustomEvent).detail;
      if (source === 'year' && active && selected !== null) { selected = null; apply(); }
    });
    buttons.forEach(button => {
      button.addEventListener('focus', () => setCurrent(button));
      button.addEventListener('click', () => {
        const letter = button.dataset.letterButton!;
        selected = selected === letter ? null : letter; // clicking the selected letter clears it
        apply();
        window.dispatchEvent(new CustomEvent('bin-change', { detail: { source: 'letter', active: selected !== null } }));
      });
    });
  });
</script>

<style>
    .alphabet-picker { flex: none; width: 40ch; }
  .alphabet-picker pre { margin: 0; font: inherit; white-space: pre; overflow-x: auto; }
  .alphabet-picker button { font: inherit; color: inherit; background: none; border: 0; padding: 0; margin: 0; cursor: pointer; }
  .alphabet-picker button:focus-visible { background: CanvasText; color: Canvas; outline: none; }
  .alphabet-picker button:disabled { opacity: 0.4; cursor: default; }
</style>
