---
const { album } = Astro.props;
const imageUrl = album.coverUrl;
const copyCount = album.copies?.length ?? 0;
---
<article class="album-card">
  <div class="cover-container">
    {copyCount > 1 && (
      <div class="copy-controls">
        <button
          type="button"
          class="copy-badge"
          onclick="event.stopPropagation(); document.querySelectorAll('.copy-controls.open').forEach(el => { if (el !== this.parentElement) el.classList.remove('open'); }); this.parentElement.classList.toggle('open')"
        >{copyCount}</button>
        <div class="copy-flyout">
          {album.copies.map((copy, index) => (
            <div class="copy-detail">
              <div class="copy-header">
                {copy.Released} • {copy.Label}
              </div>

              <div class="copy-format">
                {copy.Format?.split(',').map(part => (
                  <div>{part.trim()}</div>
                ))}
              </div>

              <div class="copy-condition">
                {copy['Collection Media Condition']}
              </div>

              {copy['Collection Notes'] && (
                <div class="copy-notes">
                  {copy['Collection Notes']}
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    )}
    <img src={imageUrl} alt={album.title} class="album-cover" />
  </div>

  <div class="album-meta">
    <h3>{album.title}</h3>
    <div class="year">{album.year}</div>
  </div>
</article>

<script>
  document.addEventListener('click', (event) => {
    document.querySelectorAll('.copy-controls.open').forEach((el) => {
      if (!el.contains(event.target)) {
        el.classList.remove('open');
      }
    });
  });
</script>

<style>
  .album-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 150px;
  }

  .cover-container { position: relative; }
  .cover-container img {
    display:block; width:100%; aspect-ratio:1; object-fit:cover;
    border-radius:6px; box-shadow:0 2px 8px rgb(0 0 0 / 0.15);
  }

  .copy-controls { position:absolute; top:8px; right:8px; }

  .copy-badge {
    position:absolute; top:-0.3rem; right:-0.3rem; z-index:1;
    width:2rem; height:2rem; border-radius:999px;
    display:flex; align-items:center; justify-content:center;
    background:#22c55e; color:white; font-size:0.875rem;
    font-weight:700; border:none; cursor:pointer;
  }

  .copy-flyout {
    display:none; position:absolute; top:100%; right:0; z-index:1000;
    min-width:200px; padding:12px; background:#222; color:white;
    border:1px solid #555; border-radius:6px;
    box-shadow:0 4px 12px rgb(0 0 0 / 40%);
  }

  .copy-detail + .copy-detail {
    margin-top:0.75rem; padding-top:0.75rem; border-top:1px solid #444;
  }
  .copy-header { margin-bottom:0.5rem; color:#ddd; }
  .copy-format { margin-bottom:0.5rem; }
  .copy-condition { font-weight:600; }
  .copy-notes { margin-top:0.5rem; color:#ccc; font-style:italic; }

  .copy-controls.open .copy-flyout { display:block; }

  .album-meta { display:flex; flex-direction:column; gap:0.15rem; }
  .album-meta h3 { margin:0; font-size:1rem; font-weight:600; line-height:1.2; }
  .year { font-size:0.9rem; color:#666; }
  .section { font-size:0.8rem; text-transform:uppercase; letter-spacing:0.05em; color:#999; }
</style>
