---
import { statsFieldRows } from '../lib/frame.js';
// The dots are decoration only, so they are hidden from assistive tech.
const { dotRow, rows } = statsFieldRows(Astro.props.lines);
---
<pre class="stats-field"><span aria-hidden="true">{dotRow}</span>{'\n'}{rows.map(({ text, lead, trail }) => <Fragment><span aria-hidden="true">{lead}</span>{text}<span aria-hidden="true">{trail}</span>{'\n'}</Fragment>)}<span aria-hidden="true">{dotRow}</span></pre>
<style>
  .stats-field { font: inherit; white-space: pre; overflow-x: auto; overflow-y: hidden; padding-block: 0.15em; margin: 1.5rem 0 1rem; }
</style>
